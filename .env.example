# AutoBI Production Environment Configuration
FLASK_ENV=production
DEBUG=False
SECRET_KEY=generate-a-secure-random-32-byte-secret-key-here

# Server Bindings
HOST=0.0.0.0
PORT=5000
THREADS=4

# Storage & Directory Paths
UPLOAD_FOLDER=uploads
CACHE_FOLDER=cache
DATA_FOLDER=data
DB_PATH=data/autobi.db
LOG_FILE=logs/autobi.log

# Limits & Controls
MAX_CONTENT_LENGTH=52428800 # 50 MB
PREVIEW_ROWS_LIMIT=500
MAX_FILTER_UNIQUE_VALUES=100
CACHE_PARQUET=True

